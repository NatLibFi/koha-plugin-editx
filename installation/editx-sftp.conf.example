# shellcheck shell=sh
# shellcheck disable=SC2034
# Standalone config example for cronjobs/fetch_editx_sftp.sh.
# The plugin cronjob_nightly hook normally generates this from the web configuration.
# If copied to /etc/koha/sites/<instance>/editx-sftp.conf, keep it out of git.
# The Koha instance user must be able to read this file.

SFTP_HOST=sftp.example.org
SFTP_PORT=22
SFTP_USER=editx-user

# Prefer SSH keys and host-key pinning. Do not store SFTP passwords here.
SFTP_IDENTITY_FILE=/var/lib/koha/<instance>/.ssh/editx_sftp
SFTP_KNOWN_HOSTS_FILE=/var/lib/koha/<instance>/.ssh/known_hosts
SFTP_STRICT_HOST_KEY_CHECKING=yes

SFTP_REMOTE_DIR=/outgoing/editx
SFTP_PATTERN='*.xml'

# Standalone mode only. The plugin web configuration normally provides this path.
# Use the same directory as import_tmp_path from the plugin configuration page.
SFTP_LOCAL_DIR=/var/spool/koha/<instance>/editx/tmp

# keep: leave remote files as-is
# archive: move downloaded remote files to SFTP_REMOTE_ARCHIVE_DIR
# delete: delete downloaded remote files
SFTP_AFTER_DOWNLOAD=archive
SFTP_REMOTE_ARCHIVE_DIR=/outgoing/editx/archive

# Optional local log file. Cron mail is used when unset.
# SFTP_LOG_FILE=/var/log/koha/<instance>/editx/sftp-download.log

# Optional plugin-style runtime log for standalone fetch tests.
# When the plugin nightly hook runs this script, these values are generated by the plugin.
# EDITX_RUNTIME_LOG=/var/log/koha/<instance>/editx/editx-runtime.log
# EDITX_RUNTIME_LOG_LEVEL=info

# Multiple standalone targets can be configured with target-specific variables:
#
# SFTP_TARGETS='alexandria_library pergamum_library'
# SFTP_alexandria_library_HOST=sftp.example.org
# SFTP_alexandria_library_USER=editx-user
# SFTP_alexandria_library_IDENTITY_FILE=/var/lib/koha/<instance>/.ssh/editx_sftp
# SFTP_alexandria_library_REMOTE_DIR=/out/alexandria
# SFTP_alexandria_library_LOCAL_DIR=/var/spool/koha/<instance>/editx/tmp
# SFTP_pergamum_library_HOST=sftp.example.org
# SFTP_pergamum_library_USER=editx-user
# SFTP_pergamum_library_IDENTITY_FILE=/var/lib/koha/<instance>/.ssh/editx_sftp
# SFTP_pergamum_library_REMOTE_DIR=/out/pergamum
# SFTP_pergamum_library_LOCAL_DIR=/var/spool/koha/<instance>/editx/tmp
