[% USE raw %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: EDItX plugin v[% plugin_display_version | html %]</title>
<link rel="stylesheet" href="/api/v1/contrib/editx/static/static_files/editx.css" />
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_editx_tool" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

[% INCLUDE 'editx_breadcrumbs.inc' active_text='Operations' active_method='tool' %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-12 col-xl-10">
            <main>
                [% INCLUDE 'messages.inc' %]

                <div class="page-section editx-page-header">
                    <div>
                        <h1>EDItX plugin v[% plugin_display_version | html %]</h1>
                        <p class="help-block">Run saved EDItX source intake and import operations, then open the created acquisition records.</p>
                    </div>
                    <div class="editx-status-strip">
                        <div class="editx-status-item">
                            <span class="editx-status-label">Nightly sources</span>
                            <strong>[% enabled_source_count | html %]</strong>
                            <span class="editx-status-note"><a href="[% configure_href | html %]">Configure</a></span>
                        </div>
                        <div class="editx-status-item [% IF source_config_has_errors %]editx-status-warning[% END %]">
                            <span class="editx-status-label">EDItX sources</span>
                            <strong>[% source_count | html %]</strong>
                            <span class="editx-status-note">Saved source[% UNLESS source_count == 1 %]s[% END %]</span>
                        </div>
                        <div class="editx-status-item">
                            <span class="editx-status-label">Import intake</span>
                            <strong>[% IF procurement_settings.import_tmp_path %]Configured[% ELSE %]Missing[% END %]</strong>
                            <span class="editx-status-note">[% procurement_settings.import_tmp_path | html %]</span>
                        </div>
                    </div>
                </div>

                [% FOREACH message IN messages %]
                    <div class="alert alert-[% message.alert_class | html %]">[% message.text | html %]</div>
                [% END %]

                [% FOREACH message IN source_config_messages %]
                    <div class="alert alert-[% message.alert_class | html %]">
                        [% message.text | html %]
                        <a href="[% configure_href | html %]">Open configuration</a>
                    </div>
                [% END %]

                [% UNLESS manual_run_confirmation %]
                    <div class="page-section editx-staged-workflow">
                        <div class="editx-section-heading">
                            <div>
                                <h2>Staged manual workflow</h2>
                                <p>Check source files, stage selected shipment notices for preview, then import only the selected local files.</p>
                            </div>
                            [% UNLESS manual_stage %]
                                <form method="post" class="editx-inline-action">
                                    <input type="hidden" name="class" value="[% CLASS | html %]" />
                                    <input type="hidden" name="method" value="[% METHOD | html %]" />
                                    <input type="hidden" name="op" value="cud-review-stage-check-remote" />
                                    <input type="hidden" name="review_stage_check_remote" value="1" />
                                    [% INCLUDE 'csrf-token.inc' %]
                                    [% IF manual_stage_sources.size > 1 %]
                                        <div class="editx-source-selector">
                                            [% FOREACH source IN manual_stage_sources %]
                                                <label>
                                                    <input type="checkbox" name="manual_source_id" value="[% source.id | html %]" checked="checked" />
                                                    <span>[% source.id | html %]</span>
                                                    <span class="editx-status-note">[% source.description | html %]</span>
                                                </label>
                                            [% END %]
                                        </div>
                                    [% ELSIF manual_stage_sources.size == 1 %]
                                        [% FOREACH source IN manual_stage_sources %]
                                            <input type="hidden" name="manual_source_id" value="[% source.id | html %]" />
                                        [% END %]
                                    [% END %]
                                    [% UNLESS manual_run_available %]
                                        <p class="editx-action-note">
                                            Fix EDItX source configuration before using the staged workflow.
                                            <a href="[% configure_href | html %]">Open configuration</a>
                                        </p>
                                    [% END %]
                                    <button type="submit"
                                            class="btn btn-primary"
                                            [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Stage 1: Check source files</button>
                                </form>
                            [% END %]
                        </div>

                    [% IF manual_stage && manual_stage.step == 'source' %]
                        <h3>EDItX source files</h3>
                        [% IF manual_stage.files.size %]
                            <form method="post" class="editx-stage-form">
                                <input type="hidden" name="class" value="[% CLASS | html %]" />
                                <input type="hidden" name="method" value="[% METHOD | html %]" />
                                <input type="hidden" name="op" value="cud-stage-download-selected" />
                                <input type="hidden" name="stage_download_selected" value="1" />
                                [% INCLUDE 'csrf-token.inc' %]
                                <table id="editx-source-files-table"
                                       class="table table-striped editx-stage-table"
                                       data-editx-stage-selection-table="source_file">
                                    <thead>
                                        <tr>
                                            <th class="NoSort editx-stage-selection-cell"><input type="checkbox" data-editx-check-all="source_file" aria-label="Select all filtered source files" /></th>
                                            <th>Source</th>
                                            <th>Filename</th>
                                            <th class="editx-stage-modified-cell">Modified</th>
                                            <th>Size</th>
                                            <th>Local status</th>
                                            <th>Successful import action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH file IN manual_stage.files %]
                                            <tr>
                                                <td class="editx-stage-selection-cell"><input type="checkbox" name="source_file" value="[% file.key | html %]" /></td>
                                                <td>[% file.source_id | html %]</td>
                                                <td><code>[% file.filename | html %]</code></td>
                                                <td class="editx-stage-modified-cell">[% file.modified | html %]</td>
                                                <td>[% file.size | html %]</td>
                                                <td>[% file.local_status | html %]</td>
                                                <td>[% file.after_action | html %]</td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                                <div class="editx-confirm-actions">
                                    <button type="submit" class="btn btn-primary">Stage selected</button>
                                    <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                                </div>
                            </form>
                        [% ELSE %]
                            <p>No EDItX files matched the configured sources.</p>
                            <form method="post" class="editx-confirm-actions">
                                <input type="hidden" name="class" value="[% CLASS | html %]" />
                                <input type="hidden" name="method" value="[% METHOD | html %]" />
                                <input type="hidden" name="op" value="cud-stage-check-remote" />
                                <input type="hidden" name="stage_check_remote" value="1" />
                                [% INCLUDE 'csrf-token.inc' %]
                                <button type="submit"
                                        class="btn btn-default"
                                        [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Check source files again</button>
                                <a class="btn btn-default" href="[% tool_href | html %]">Return to start</a>
                            </form>
                        [% END %]
                    [% END %]

                    [% IF manual_stage && manual_stage.step == 'downloaded' %]
                        <form method="post" class="editx-stage-form">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="cud-stage-import-selected" />
                            <input type="hidden" name="stage_import_selected" value="1" />
                            <input type="hidden" name="manual_stage_run_id" value="[% manual_stage.run_id | html %]" />
                            [% INCLUDE 'csrf-token.inc' %]

                            <h3>Staged EDItX preview</h3>
                            [% IF manual_stage.summary %]
                                <p>
                                    Staged <strong>[% manual_stage.summary.files | html %]</strong> file(s),
                                    <strong>[% manual_stage.summary.items | html %]</strong> item line(s),
                                    <strong>[% manual_stage.summary.copies | html %]</strong> copy/copies.
                                </p>
                            [% END %]
                            <table id="editx-staged-files-table"
                                   class="table table-striped editx-stage-table"
                                   data-editx-stage-selection-table="stage_file">
                                <thead>
                                    <tr>
                                        <th class="NoSort editx-stage-selection-cell"><input type="checkbox" data-editx-check-all="stage_file" aria-label="Select all filtered importable staged files" /></th>
                                        <th>Filename</th>
                                        <th>Notice / Total</th>
                                        <th>Seller / Vendor IDs</th>
                                        <th>Lines / Copies</th>
                                        <th>Product forms</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH file IN manual_stage.files %]
                                        [% SET file_duplicate_blocked = file.duplicate_import_blocked == 1 %]
                                        [% SET file_importable = file.status == 'valid' && file_duplicate_blocked != 1 %]
                                        <tr[% IF file.duplicate_import_blocked %] class="editx-stage-row-duplicate"[% END %]>
                                            <td class="editx-stage-selection-cell">
                                                <input type="checkbox"
                                                       name="stage_file"
                                                       value="[% file.id | html %]"
                                                       [% IF file_importable %]checked="checked"[% END %]
                                                       [% UNLESS file_importable %]disabled="disabled"[% END %] />
                                            </td>
                                            <td>
                                                <code>[% file.filename | html %]</code>
                                                <div class="editx-status-note">[% file.source_id | html %]</div>
                                            </td>
                                            <td>
                                                <span class="editx-notice-id">[% file.ship_notice_number | html %]</span>
                                                <div class="editx-status-note">[% file.document_type | html %]</div>
                                                <div>
                                                    [% file.estimated_total | html %]
                                                    [% IF file.currencies %]<span class="editx-status-note">[% file.currencies | html %]</span>[% END %]
                                                </div>
                                            </td>
                                            <td>
                                                [% file.seller_name | html %]
                                                [% IF file.buyer_contact %]
                                                    <div class="editx-status-note">Contact: [% file.buyer_contact | html %]</div>
                                                [% END %]
                                                <span class="editx-status-note">VendorAssignedID: [% file.vendor_assigned_id | html %]</span>
                                                <span class="editx-status-note">BuyerAssignedID: [% file.buyer_assigned_id | html %]</span>
                                            </td>
                                            <td>[% file.item_count | html %] / [% file.copy_count | html %]</td>
                                            <td>[% file.product_forms | html %]</td>
                                            <td>
                                                [% IF file.status == 'valid' %]
                                                    <span class="text-success">XML OK</span>
                                                [% ELSE %]
                                                    <span class="text-danger">XML error</span>
                                                [% END %]
                                                <span class="editx-status-note">Vendor: [% file.vendor_status | html %]</span>
                                                <span class="editx-status-note">Duplicate: [% file.duplicate_status | html %]</span>
                                                [% IF file.duplicate_message %]<span class="editx-status-note editx-duplicate-note">[% file.duplicate_message | html %]</span>[% END %]
                                                [% IF file.error %]<span class="editx-status-note">[% file.error | html %]</span>[% END %]
                                                [% IF file.vendor_message %]<span class="editx-status-note">[% file.vendor_message | html %]</span>[% END %]
                                            </td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                            <div class="editx-confirm-actions">
                                <button type="submit" class="btn btn-primary">Import selected</button>
                                <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                            </div>
                        </form>
                    [% END %]

                    [% IF manual_stage && manual_stage.step == 'imported' && manual_stage.import_result %]
                        <div class="editx-stage-result">
                            <h3>Selected EDItX import result</h3>
                            <p class="editx-stage-result-summary">
                                Processed <strong>[% manual_stage.import_result.processed | html %]</strong>,
                                failed <strong>[% manual_stage.import_result.failed | html %]</strong>,
                                skipped <strong>[% manual_stage.import_result.skipped | html %]</strong>.
                            </p>
                            [% IF manual_stage.import_result.source_cleanup %]
                                <p class="editx-stage-result-note">
                                    Source cleanup:
                                    kept <strong>[% manual_stage.import_result.source_cleanup.kept | html %]</strong>,
                                    deleted <strong>[% manual_stage.import_result.source_cleanup.deleted | html %]</strong>,
                                    archived <strong>[% manual_stage.import_result.source_cleanup.archived | html %]</strong>,
                                    failed <strong>[% manual_stage.import_result.source_cleanup.failed | html %]</strong>.
                                    [% IF manual_stage.import_result.source_cleanup.failed %]
                                        Review the EDItX runtime log before retrying source cleanup manually.
                                    [% END %]
                                </p>
                            [% END %]
                            [% IF manual_stage.import_result.skipped_files && manual_stage.import_result.skipped_files.size %]
                                <h4>Skipped files</h4>
                                <p class="editx-stage-result-note">
                                    These files were not imported and existing Koha acquisition data was not changed.
                                    Open the existing basket links to review the already imported order lines.
                                </p>
                                <table class="table table-striped editx-stage-table editx-stage-result-table">
                                    <thead>
                                        <tr>
                                            <th>Filename</th>
                                            <th>EDItX notice</th>
                                            <th>Existing Koha basket</th>
                                            <th>Existing Koha orders</th>
                                            <th>Reason</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH file IN manual_stage.import_result.skipped_files %]
                                            <tr class="editx-stage-row-duplicate">
                                                <td>
                                                    <code>[% file.filename | html %]</code>
                                                    [% IF file.source_id %]<div class="editx-status-note">[% file.source_id | html %]</div>[% END %]
                                                </td>
                                                <td>
                                                    <span class="editx-notice-id">[% file.ship_notice_number | html %]</span>
                                                </td>
                                                <td>
                                                    [% IF file.existing_basketno %]
                                                        [% SET existing_basket_label = file.existing_basketname || file.existing_basketno %]
                                                        [% IF file.existing_basket_url %]
                                                            <a href="[% file.existing_basket_url | html %]">[% existing_basket_label | html %]</a>
                                                        [% ELSE %]
                                                            [% existing_basket_label | html %]
                                                        [% END %]
                                                        <div class="editx-status-note">Basket [% file.existing_basketno | html %]</div>
                                                        [% IF file.existing_vendor_name %]
                                                            <div class="editx-status-note">
                                                                Vendor:
                                                                [% IF file.existing_vendor_url %]
                                                                    <a href="[% file.existing_vendor_url | html %]">[% file.existing_vendor_name | html %]</a>
                                                                [% ELSE %]
                                                                    [% file.existing_vendor_name | html %]
                                                                [% END %]
                                                            </div>
                                                        [% END %]
                                                    [% ELSE %]
                                                        <span class="editx-status-note">Not resolved</span>
                                                    [% END %]
                                                </td>
                                                <td>
                                                    [% IF file.existing_order_count != '' %]
                                                        [% file.existing_order_count | html %] order line(s),
                                                        [% file.existing_item_count | html %] item(s)
                                                        [% IF file.existing_order_range %]<div class="editx-status-note">Order range [% file.existing_order_range | html %]</div>[% END %]
                                                    [% ELSE %]
                                                        <span class="editx-status-note">Not resolved</span>
                                                    [% END %]
                                                </td>
                                                <td>
                                                    [% file.reason_label | html %]
                                                    [% IF file.message %]<div class="editx-status-note editx-duplicate-note">[% file.message | html %]</div>[% END %]
                                                </td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                            [% END %]
                        </div>
                        <form method="post" class="editx-confirm-actions">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="cud-stage-check-remote" />
                            <input type="hidden" name="stage_check_remote" value="1" />
                            [% INCLUDE 'csrf-token.inc' %]
                            <button type="submit"
                                    class="btn btn-default"
                                    [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Check source files again</button>
                            <a class="btn btn-default" href="[% tool_href | html %]">Return to start</a>
                        </form>
                    [% END %]
                </div>
                [% END %]

                [% IF manual_run_attempted %]
                    <div class="page-section editx-manual-sync-result">
                        <h2>Acquisition result</h2>
                        [% IF manual_sync_result && manual_sync_result.order_count %]
                            <p>
                                Created
                                <strong>[% manual_sync_result.order_count | html %]</strong>
                                acquisition order line(s) for
                                <strong>[% manual_sync_result.item_count | html %]</strong>
                                item(s). Open the created basket(s) in Acquisitions:
                            </p>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Basket</th>
                                        <th>Vendor</th>
                                        <th>Orders</th>
                                        <th>Items</th>
                                        <th>Order range</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH basket IN manual_sync_result.baskets %]
                                        <tr>
                                            <td>
                                                <a href="[% basket.basket_url | html %]">[% basket.basketname | html %] ([% basket.basketno | html %])</a>
                                            </td>
                                            <td>
                                                [% IF basket.vendor_url %]
                                                    <a href="[% basket.vendor_url | html %]">[% basket.vendor_name | html %]</a>
                                                [% ELSE %]
                                                    [% basket.vendor_name | html %]
                                                [% END %]
                                            </td>
                                            <td>[% basket.order_count | html %]</td>
                                            <td>[% basket.item_count | html %]</td>
                                            <td>[% basket.first_ordernumber | html %]-[% basket.last_ordernumber | html %]</td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                        [% ELSE %]
                            <p>No new acquisition order lines were found for this import.</p>
                            <p>
                                <a class="btn btn-default" href="[% manual_sync_result.history_url | html %]">Search acquisition orders from this run date</a>
                            </p>
                        [% END %]
                    </div>
                [% END %]

                [% IF manual_run_confirmation %]
                    <div class="page-section editx-manual-sync-confirmation">
                        <h2>[% manual_run_confirmation.title | html %]</h2>
                        <p>[% manual_run_confirmation.description | html %]</p>

                        [% IF manual_run_confirmation.sftp_sources.size %]
                        <h3>SFTP intake</h3>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Remote</th>
                                    <th>Pattern</th>
                                    <th>Local target</th>
                                    <th>Successful import action</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH source IN manual_run_confirmation.sftp_sources %]
                                    <tr>
                                        <td>[% source.id | html %]</td>
                                        <td>
                                            [% source.user | html %]@[% source.host | html %]:[% source.port | html %]
                                            <code>[% source.remote_dir | html %]</code>
                                            [% IF source.identity_file %]
                                                <span class="editx-status-note">Identity file: [% source.identity_file | html %]</span>
                                            [% END %]
                                            [% IF source.known_hosts_file %]
                                                <span class="editx-status-note">Known hosts: [% source.known_hosts_file | html %]</span>
                                            [% END %]
                                        </td>
                                        <td><code>[% source.pattern | html %]</code></td>
                                        <td>
                                            <code>[% source.local_dir | html %]</code>
                                            <span class="editx-status-note">[% source.local_dir_note | html %]</span>
                                        </td>
                                        <td>
                                            [% source.success_action | html %]
                                            [% IF source.remote_archive_dir %]
                                                <span class="editx-status-note">Remote archive: [% source.remote_archive_dir | html %]</span>
                                            [% END %]
                                        </td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>
                        [% END %]

                        [% IF manual_run_confirmation.folder_sources.size %]
                        <h3>Folder intake</h3>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Folder</th>
                                    <th>Pattern</th>
                                    <th>Minimum age</th>
                                    <th>Successful import action</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH source IN manual_run_confirmation.folder_sources %]
                                    <tr>
                                        <td>[% source.id | html %]</td>
                                        <td><code>[% source.local_dir | html %]</code></td>
                                        <td><code>[% source.pattern | html %]</code></td>
                                        <td>[% source.minimum_age_seconds | html %] second(s)</td>
                                        <td>
                                            [% source.success_action | html %]
                                            [% IF source.local_archive_dir %]
                                                <span class="editx-status-note">Local archive: [% source.local_archive_dir | html %]</span>
                                            [% END %]
                                        </td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>
                        [% END %]

                        <h3>Import folders</h3>
                        <table class="table table-striped">
                            <tbody>
                                [% FOREACH folder IN manual_run_confirmation.folders %]
                                    <tr>
                                        <th>[% folder.label | html %]</th>
                                        <td><code>[% folder.path | html %]</code></td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <form method="post" class="editx-confirm-actions">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="[% manual_run_confirmation.op | html %]" />
                            <input type="hidden" name="[% manual_run_confirmation.input_name | html %]" value="1" />
                            [% IF manual_run_confirmation.action == 'stage_check_remote' %]
                                [% FOREACH source IN manual_run_confirmation.sources %]
                                    <input type="hidden" name="manual_source_id" value="[% source.id | html %]" />
                                [% END %]
                            [% END %]
                            [% INCLUDE 'csrf-token.inc' %]
                            <button type="submit" class="btn btn-primary">[% manual_run_confirmation.button_label | html %]</button>
                            <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                        </form>
                    </div>
                [% END %]

                [% UNLESS manual_run_confirmation || manual_stage %]
                <div class="editx-or-separator">
                    <span>OR</span>
                </div>
                <form method="post" class="page-section editx-manual-sync-form">
                    <input type="hidden" name="class" value="[% CLASS | html %]" />
                    <input type="hidden" name="method" value="[% METHOD | html %]" />
                    <input type="hidden" name="op" value="cud-run-sync-now" />
                    <input type="hidden" name="run_sync_now" value="1" />
                    [% INCLUDE 'csrf-token.inc' %]
                    <div>
                        <h2>Stage and import</h2>
                        <p>Runs the full saved source intake and import chain in one operation.</p>
                        [% UNLESS manual_run_available %]
                            <p class="editx-action-note">
                                Fix EDItX source configuration before running a manual import.
                                <a href="[% configure_href | html %]">Open configuration</a>
                            </p>
                        [% END %]
                    </div>
                    <button type="submit"
                            class="btn btn-primary"
                            [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Run full intake and import</button>
                </form>
                [% END %]
            </main>
        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %]
    [% INCLUDE 'datatables.inc' %]
    <script>
        (function () {
            const stageSelectionTables = document.querySelectorAll("[data-editx-stage-selection-table]");
            const dragState = {
                active: false,
                checked: false,
                name: "",
                table: null,
            };

            function checkboxSelector(name) {
                return 'input[type="checkbox"][name="' + name + '"]';
            }

            function dataTableFor(table) {
                if (!window.jQuery || !jQuery.fn.DataTable || !jQuery.fn.dataTable.isDataTable(table)) {
                    return null;
                }
                return jQuery(table).DataTable();
            }

            function selectableCheckboxes(table, name) {
                const dataTable = dataTableFor(table);
                const nodes = dataTable
                    ? dataTable.rows({ search: "applied" }).nodes().toArray()
                    : Array.from(table.querySelectorAll("tbody tr"));

                return nodes
                    .map(function (row) {
                        return row.querySelector(checkboxSelector(name));
                    })
                    .filter(function (checkbox) {
                        return checkbox && !checkbox.disabled;
                    });
            }

            function visibleCheckboxes(table, name) {
                return Array.from(table.querySelectorAll("tbody " + checkboxSelector(name))).filter(function (checkbox) {
                    return !checkbox.disabled;
                });
            }

            function allCheckboxes(table, name) {
                const dataTable = dataTableFor(table);
                const nodes = dataTable
                    ? dataTable.rows().nodes().toArray()
                    : Array.from(table.querySelectorAll("tbody tr"));

                return nodes
                    .map(function (row) {
                        return row.querySelector(checkboxSelector(name));
                    })
                    .filter(Boolean);
            }

            function updateSelectAll(table, name, selected) {
                const toggle = table.querySelector('[data-editx-check-all="' + name + '"]');
                if (!toggle) {
                    return;
                }

                const checkboxes = selectableCheckboxes(table, name);
                const selectedCount = checkboxes.filter(function (checkbox) {
                    return selected.has(checkbox.value);
                }).length;

                toggle.checked = checkboxes.length > 0 && selectedCount === checkboxes.length;
                toggle.indeterminate = selectedCount > 0 && selectedCount < checkboxes.length;
            }

            function setCheckboxSelection(table, name, selected, checkbox, checked) {
                if (!checkbox || checkbox.disabled) {
                    return;
                }

                checkbox.checked = checked;
                if (checked) {
                    selected.add(checkbox.value);
                } else {
                    selected.delete(checkbox.value);
                }
                updateSelectAll(table, name, selected);
            }

            function syncVisibleCheckboxes(table, name, selected) {
                visibleCheckboxes(table, name).forEach(function (checkbox) {
                    checkbox.checked = selected.has(checkbox.value);
                });
                updateSelectAll(table, name, selected);
            }

            function selectionCellFromEvent(table, event) {
                const cell = event.target.closest("td.editx-stage-selection-cell");
                if (!cell || !table.contains(cell)) {
                    return null;
                }
                return cell;
            }

            function clearDragHighlights() {
                document.querySelectorAll(".editx-stage-selection-cell.is-editx-selection-drag-active").forEach(function (cell) {
                    cell.classList.remove("is-editx-selection-drag-active");
                });
            }

            function addHiddenSelections(form, name, selected) {
                form.querySelectorAll('input.editx-stage-selection-hidden[name="' + name + '"]').forEach(function (input) {
                    input.remove();
                });

                selected.forEach(function (value) {
                    const input = document.createElement("input");
                    input.type = "hidden";
                    input.name = name;
                    input.value = value;
                    input.className = "editx-stage-selection-hidden";
                    form.appendChild(input);
                });
            }

            function initializeStageSelectionTable(table) {
                const name = table.getAttribute("data-editx-stage-selection-table");
                const form = table.closest("form");
                const selected = new Set();

                table.querySelectorAll(checkboxSelector(name)).forEach(function (checkbox) {
                    if (checkbox.checked && !checkbox.disabled) {
                        selected.add(checkbox.value);
                    }
                });

                if (window.jQuery && jQuery.fn.kohaTable) {
                    jQuery(table).kohaTable({
                        columnDefs: [
                            { targets: [0], orderable: false, searchable: false },
                        ],
                        order: [],
                        pageLength: 25,
                        paginationType: "full",
                        drawCallback: function () {
                            syncVisibleCheckboxes(table, name, selected);
                        },
                    });
                }

                table.addEventListener("change", function (event) {
                    const checkbox = event.target.closest(checkboxSelector(name));
                    if (!checkbox) {
                        return;
                    }
                    setCheckboxSelection(table, name, selected, checkbox, checkbox.checked);
                });

                table.addEventListener("change", function (event) {
                    const toggle = event.target.closest('[data-editx-check-all="' + name + '"]');
                    if (!toggle) {
                        return;
                    }

                    const checked = toggle.checked;
                    selectableCheckboxes(table, name).forEach(function (checkbox) {
                        setCheckboxSelection(table, name, selected, checkbox, checked);
                    });
                    syncVisibleCheckboxes(table, name, selected);
                });

                table.addEventListener("mousedown", function (event) {
                    if (event.button !== 0 || event.target.closest("input")) {
                        return;
                    }

                    const cell = selectionCellFromEvent(table, event);
                    if (!cell) {
                        return;
                    }

                    const checkbox = cell.querySelector(checkboxSelector(name));
                    if (!checkbox || checkbox.disabled) {
                        return;
                    }

                    dragState.active = true;
                    dragState.checked = !checkbox.checked;
                    dragState.name = name;
                    dragState.table = table;
                    cell.classList.add("is-editx-selection-drag-active");
                    setCheckboxSelection(table, name, selected, checkbox, dragState.checked);
                    event.preventDefault();
                });

                table.addEventListener("mouseover", function (event) {
                    if (!dragState.active || dragState.table !== table || dragState.name !== name) {
                        return;
                    }

                    const cell = selectionCellFromEvent(table, event);
                    if (!cell) {
                        return;
                    }

                    const checkbox = cell.querySelector(checkboxSelector(name));
                    cell.classList.add("is-editx-selection-drag-active");
                    setCheckboxSelection(table, name, selected, checkbox, dragState.checked);
                });

                if (form) {
                    form.addEventListener("submit", function () {
                        allCheckboxes(table, name).forEach(function (checkbox) {
                            checkbox.disabled = true;
                        });
                        addHiddenSelections(form, name, selected);
                    });
                }

                syncVisibleCheckboxes(table, name, selected);
            }

            document.addEventListener("mouseup", function () {
                dragState.active = false;
                dragState.checked = false;
                dragState.name = "";
                dragState.table = null;
                clearDragHighlights();
            });

            stageSelectionTables.forEach(initializeStageSelectionTable);
        })();
    </script>
[% END %]

[% INCLUDE 'intranet-bottom.inc' %]
