[% USE raw %]
[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: EDItX plugin v[% plugin_display_version | html %]</title>
<link rel="stylesheet" href="/api/v1/contrib/editx/static/static_files/editx.css" />
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_editx_tool" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

[% INCLUDE 'editx_breadcrumbs.inc' active_text='Operations' active_method='tool' %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-12 col-xl-10">
            <main>
                [% INCLUDE 'messages.inc' %]

                <div class="page-section editx-page-header">
                    <div>
                        <h1>EDItX plugin v[% plugin_display_version | html %]</h1>
                        <p class="help-block">Run saved EDItX SFTP download and import operations, then open the created acquisition records.</p>
                    </div>
                    <div class="editx-status-strip">
                        <div class="editx-status-item">
                            <span class="editx-status-label">Nightly automation</span>
                            <strong>[% IF nightly_sync_enabled %]Enabled[% ELSE %]Disabled[% END %]</strong>
                            <span class="editx-status-note"><a href="[% configure_href | html %]">Configure</a></span>
                        </div>
                        <div class="editx-status-item [% IF sftp_config_has_errors %]editx-status-warning[% END %]">
                            <span class="editx-status-label">SFTP sources</span>
                            <strong>[% sftp_sources_count | html %]</strong>
                            <span class="editx-status-note">Saved source[% UNLESS sftp_sources_count == 1 %]s[% END %]</span>
                        </div>
                        <div class="editx-status-item">
                            <span class="editx-status-label">Import intake</span>
                            <strong>[% IF procurement_settings.import_tmp_path %]Configured[% ELSE %]Missing[% END %]</strong>
                            <span class="editx-status-note">[% procurement_settings.import_tmp_path | html %]</span>
                        </div>
                    </div>
                </div>

                [% FOREACH message IN messages %]
                    <div class="alert alert-[% message.alert_class | html %]">[% message.text | html %]</div>
                [% END %]

                [% FOREACH message IN sftp_config_messages %]
                    <div class="alert alert-[% message.alert_class | html %]">
                        [% message.text | html %]
                        <a href="[% configure_href | html %]">Open configuration</a>
                    </div>
                [% END %]

                [% UNLESS manual_run_confirmation %]
                    <div class="page-section editx-staged-workflow">
                        <div class="editx-section-heading">
                            <div>
                                <h2>Staged manual workflow</h2>
                                <p>Check remote files, download selected shipment notices for preview, then import only the selected local files.</p>
                            </div>
                            [% UNLESS manual_stage %]
                                <form method="post" class="editx-inline-action">
                                    <input type="hidden" name="class" value="[% CLASS | html %]" />
                                    <input type="hidden" name="method" value="[% METHOD | html %]" />
                                    <input type="hidden" name="op" value="cud-review-stage-check-remote" />
                                    <input type="hidden" name="review_stage_check_remote" value="1" />
                                    [% INCLUDE 'csrf-token.inc' %]
                                    [% IF manual_stage_sources.size > 1 %]
                                        <div class="editx-source-selector">
                                            [% FOREACH source IN manual_stage_sources %]
                                                <label>
                                                    <input type="checkbox" name="manual_source_id" value="[% source.id | html %]" checked="checked" />
                                                    <span>[% source.id | html %]</span>
                                                    <span class="editx-status-note">[% source.remote | html %]</span>
                                                </label>
                                            [% END %]
                                        </div>
                                    [% ELSIF manual_stage_sources.size == 1 %]
                                        [% FOREACH source IN manual_stage_sources %]
                                            <input type="hidden" name="manual_source_id" value="[% source.id | html %]" />
                                        [% END %]
                                    [% END %]
                                    [% UNLESS manual_run_available %]
                                        <p class="editx-action-note">
                                            Fix SFTP configuration before using the staged workflow.
                                            <a href="[% configure_href | html %]">Open configuration</a>
                                        </p>
                                    [% END %]
                                    <button type="submit"
                                            class="btn btn-primary"
                                            [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Stage 1: Check remote files</button>
                                </form>
                            [% END %]
                        </div>

                    [% IF manual_stage && manual_stage.step == 'remote' %]
                        <h3>Remote EDItX files</h3>
                        [% IF manual_stage.files.size %]
                            <form method="post" class="editx-stage-form">
                                <input type="hidden" name="class" value="[% CLASS | html %]" />
                                <input type="hidden" name="method" value="[% METHOD | html %]" />
                                <input type="hidden" name="op" value="cud-stage-download-selected" />
                                <input type="hidden" name="stage_download_selected" value="1" />
                                [% INCLUDE 'csrf-token.inc' %]
                                <table class="table table-striped editx-stage-table">
                                    <thead>
                                        <tr>
                                            <th><input type="checkbox" data-editx-check-all="remote_file" aria-label="Select all remote files" /></th>
                                            <th>Source</th>
                                            <th>Filename</th>
                                            <th>Modified</th>
                                            <th>Size</th>
                                            <th>Local status</th>
                                            <th>Manual action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        [% FOREACH file IN manual_stage.files %]
                                            <tr>
                                                <td><input type="checkbox" name="remote_file" value="[% file.key | html %]" /></td>
                                                <td>[% file.source_id | html %]</td>
                                                <td><code>[% file.filename | html %]</code></td>
                                                <td>[% file.modified | html %]</td>
                                                <td>[% file.size | html %]</td>
                                                <td>[% file.local_status | html %]</td>
                                                <td>[% file.after_action | html %]</td>
                                            </tr>
                                        [% END %]
                                    </tbody>
                                </table>
                                <div class="editx-confirm-actions">
                                    <button type="submit" class="btn btn-primary">Download selected</button>
                                    <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                                </div>
                            </form>
                        [% ELSE %]
                            <p>No remote EDItX files matched the configured SFTP sources.</p>
                            <form method="post" class="editx-confirm-actions">
                                <input type="hidden" name="class" value="[% CLASS | html %]" />
                                <input type="hidden" name="method" value="[% METHOD | html %]" />
                                <input type="hidden" name="op" value="cud-stage-check-remote" />
                                <input type="hidden" name="stage_check_remote" value="1" />
                                [% INCLUDE 'csrf-token.inc' %]
                                <button type="submit"
                                        class="btn btn-default"
                                        [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Check remote files again</button>
                                <a class="btn btn-default" href="[% tool_href | html %]">Return to start</a>
                            </form>
                        [% END %]
                    [% END %]

                    [% IF manual_stage && manual_stage.step == 'downloaded' %]
                        <form method="post" class="editx-stage-form">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="cud-stage-import-selected" />
                            <input type="hidden" name="stage_import_selected" value="1" />
                            <input type="hidden" name="manual_stage_run_id" value="[% manual_stage.run_id | html %]" />
                            [% INCLUDE 'csrf-token.inc' %]

                            <h3>Downloaded EDItX preview</h3>
                            [% IF manual_stage.summary %]
                                <p>
                                    Downloaded <strong>[% manual_stage.summary.files | html %]</strong> file(s),
                                    <strong>[% manual_stage.summary.items | html %]</strong> item line(s),
                                    <strong>[% manual_stage.summary.copies | html %]</strong> copy/copies.
                                </p>
                            [% END %]
                            <table class="table table-striped editx-stage-table">
                                <thead>
                                    <tr>
                                        <th><input type="checkbox" data-editx-check-all="stage_file" aria-label="Select all importable downloaded files" /></th>
                                        <th>Filename</th>
                                        <th>Notice / Total</th>
                                        <th>Seller / Vendor IDs</th>
                                        <th>Lines / Copies</th>
                                        <th>Product forms</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH file IN manual_stage.files %]
                                        [% SET file_importable = file.status == 'valid' && file.duplicate_import_blocked != 1 %]
                                        <tr[% IF file.duplicate_import_blocked %] class="editx-stage-row-duplicate"[% END %]>
                                            <td>
                                                <input type="checkbox"
                                                       name="stage_file"
                                                       value="[% file.id | html %]"
                                                       [% IF file_importable %]checked="checked"[% END %]
                                                       [% UNLESS file_importable %]disabled="disabled"[% END %] />
                                            </td>
                                            <td>
                                                <code>[% file.filename | html %]</code>
                                                <div class="editx-status-note">[% file.source_id | html %]</div>
                                            </td>
                                            <td>
                                                <span class="editx-notice-id">[% file.ship_notice_number | html %]</span>
                                                <div class="editx-status-note">[% file.document_type | html %]</div>
                                                <div>
                                                    [% file.estimated_total | html %]
                                                    [% IF file.currencies %]<span class="editx-status-note">[% file.currencies | html %]</span>[% END %]
                                                </div>
                                            </td>
                                            <td>
                                                [% file.seller_name | html %]
                                                [% IF file.buyer_contact %]
                                                    <div class="editx-status-note">Contact: [% file.buyer_contact | html %]</div>
                                                [% END %]
                                                <span class="editx-status-note">VendorAssignedID: [% file.vendor_assigned_id | html %]</span>
                                                <span class="editx-status-note">BuyerAssignedID: [% file.buyer_assigned_id | html %]</span>
                                            </td>
                                            <td>[% file.item_count | html %] / [% file.copy_count | html %]</td>
                                            <td>[% file.product_forms | html %]</td>
                                            <td>
                                                [% IF file.status == 'valid' %]
                                                    <span class="text-success">XML OK</span>
                                                [% ELSE %]
                                                    <span class="text-danger">XML error</span>
                                                [% END %]
                                                <span class="editx-status-note">Vendor: [% file.vendor_status | html %]</span>
                                                <span class="editx-status-note">Duplicate: [% file.duplicate_status | html %]</span>
                                                [% IF file.duplicate_message %]<span class="editx-status-note editx-duplicate-note">[% file.duplicate_message | html %]</span>[% END %]
                                                [% IF file.error %]<span class="editx-status-note">[% file.error | html %]</span>[% END %]
                                                [% IF file.vendor_message %]<span class="editx-status-note">[% file.vendor_message | html %]</span>[% END %]
                                            </td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                            <div class="editx-confirm-actions">
                                <button type="submit" class="btn btn-primary">Import selected</button>
                                <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                            </div>
                        </form>
                    [% END %]

                    [% IF manual_stage && manual_stage.step == 'imported' && manual_stage.import_result %]
                        <h3>Staged import result</h3>
                        <p>
                            Processed <strong>[% manual_stage.import_result.processed | html %]</strong>,
                            failed <strong>[% manual_stage.import_result.failed | html %]</strong>,
                            skipped <strong>[% manual_stage.import_result.skipped | html %]</strong>.
                        </p>
                        <form method="post" class="editx-confirm-actions">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="cud-stage-check-remote" />
                            <input type="hidden" name="stage_check_remote" value="1" />
                            [% INCLUDE 'csrf-token.inc' %]
                            <button type="submit"
                                    class="btn btn-default"
                                    [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Check remote files again</button>
                            <a class="btn btn-default" href="[% tool_href | html %]">Return to start</a>
                        </form>
                    [% END %]
                </div>
                [% END %]

                [% IF manual_run_attempted %]
                    <div class="page-section editx-manual-sync-result">
                        <h2>Acquisition result</h2>
                        [% IF manual_sync_result && manual_sync_result.order_count %]
                            <p>
                                Created or updated
                                <strong>[% manual_sync_result.order_count | html %]</strong>
                                acquisition order line(s) for
                                <strong>[% manual_sync_result.item_count | html %]</strong>
                                item(s). Open the created basket(s) in Acquisitions:
                            </p>
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Basket</th>
                                        <th>Vendor</th>
                                        <th>Orders</th>
                                        <th>Items</th>
                                        <th>Order range</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    [% FOREACH basket IN manual_sync_result.baskets %]
                                        <tr>
                                            <td>
                                                <a href="[% basket.basket_url | html %]">[% basket.basketname | html %] ([% basket.basketno | html %])</a>
                                            </td>
                                            <td>
                                                [% IF basket.vendor_url %]
                                                    <a href="[% basket.vendor_url | html %]">[% basket.vendor_name | html %]</a>
                                                [% ELSE %]
                                                    [% basket.vendor_name | html %]
                                                [% END %]
                                            </td>
                                            <td>[% basket.order_count | html %]</td>
                                            <td>[% basket.item_count | html %]</td>
                                            <td>[% basket.first_ordernumber | html %]-[% basket.last_ordernumber | html %]</td>
                                        </tr>
                                    [% END %]
                                </tbody>
                            </table>
                        [% ELSE %]
                            <p>No new acquisition order lines were found for this import.</p>
                            <p>
                                <a class="btn btn-default" href="[% manual_sync_result.history_url | html %]">Search acquisition orders from this run date</a>
                            </p>
                        [% END %]
                    </div>
                [% END %]

                [% IF manual_run_confirmation %]
                    <div class="page-section editx-manual-sync-confirmation">
                        <h2>[% manual_run_confirmation.title | html %]</h2>
                        <p>[% manual_run_confirmation.description | html %]</p>

                        <h3>SFTP intake</h3>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Source</th>
                                    <th>Remote</th>
                                    <th>Pattern</th>
                                    <th>Local target</th>
                                    <th>After download</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH source IN manual_run_confirmation.sources %]
                                    <tr>
                                        <td>[% source.id | html %]</td>
                                        <td>
                                            [% source.user | html %]@[% source.host | html %]:[% source.port | html %]
                                            <code>[% source.remote_dir | html %]</code>
                                            [% IF source.identity_file %]
                                                <span class="editx-status-note">Identity file: [% source.identity_file | html %]</span>
                                            [% END %]
                                            [% IF source.known_hosts_file %]
                                                <span class="editx-status-note">Known hosts: [% source.known_hosts_file | html %]</span>
                                            [% END %]
                                        </td>
                                        <td><code>[% source.pattern | html %]</code></td>
                                        <td>
                                            <code>[% source.local_dir | html %]</code>
                                            <span class="editx-status-note">[% source.local_dir_note | html %]</span>
                                        </td>
                                        <td>
                                            [% source.after_download | html %]
                                            [% IF source.remote_archive_dir %]
                                                <span class="editx-status-note">Remote archive: [% source.remote_archive_dir | html %]</span>
                                            [% END %]
                                        </td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <h3>Import folders</h3>
                        <table class="table table-striped">
                            <tbody>
                                [% FOREACH folder IN manual_run_confirmation.folders %]
                                    <tr>
                                        <th>[% folder.label | html %]</th>
                                        <td><code>[% folder.path | html %]</code></td>
                                    </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <form method="post" class="editx-confirm-actions">
                            <input type="hidden" name="class" value="[% CLASS | html %]" />
                            <input type="hidden" name="method" value="[% METHOD | html %]" />
                            <input type="hidden" name="op" value="[% manual_run_confirmation.op | html %]" />
                            <input type="hidden" name="[% manual_run_confirmation.input_name | html %]" value="1" />
                            [% IF manual_run_confirmation.action == 'stage_check_remote' %]
                                [% FOREACH source IN manual_run_confirmation.sources %]
                                    <input type="hidden" name="manual_source_id" value="[% source.id | html %]" />
                                [% END %]
                            [% END %]
                            [% INCLUDE 'csrf-token.inc' %]
                            <button type="submit" class="btn btn-primary">[% manual_run_confirmation.button_label | html %]</button>
                            <a class="btn btn-default" href="[% tool_href | html %]">Cancel</a>
                        </form>
                    </div>
                [% END %]

                [% UNLESS manual_run_confirmation || manual_stage %]
                <div class="editx-or-separator">
                    <span>OR</span>
                </div>
                <form method="post" class="page-section editx-manual-sync-form">
                    <input type="hidden" name="class" value="[% CLASS | html %]" />
                    <input type="hidden" name="method" value="[% METHOD | html %]" />
                    <input type="hidden" name="op" value="cud-run-sync-now" />
                    <input type="hidden" name="run_sync_now" value="1" />
                    [% INCLUDE 'csrf-token.inc' %]
                    <div>
                        <h2>Download and import</h2>
                        <p>Runs the full saved SFTP download and import chain in one operation.</p>
                        [% UNLESS manual_run_available %]
                            <p class="editx-action-note">
                                Fix SFTP configuration before running a manual import.
                                <a href="[% configure_href | html %]">Open configuration</a>
                            </p>
                        [% END %]
                    </div>
                    <button type="submit"
                            class="btn btn-primary"
                            [% UNLESS manual_run_available %]disabled="disabled"[% END %]>Run full download and import</button>
                </form>
                [% END %]
            </main>
        </div>
    </div>
</div>

<script>
document.querySelectorAll('[data-editx-check-all]').forEach(function (toggle) {
    toggle.addEventListener('change', function () {
        var name = toggle.getAttribute('data-editx-check-all');
        document.querySelectorAll('input[name="' + name + '"]:not(:disabled)').forEach(function (checkbox) {
            checkbox.checked = toggle.checked;
        });
    });
});
</script>

[% INCLUDE 'intranet-bottom.inc' %]
