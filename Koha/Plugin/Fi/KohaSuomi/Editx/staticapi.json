      "tags": [
        "pluginStatic"
      ],
      "parameters": [
        {
          "name": "v",
          "in": "query",
          "required": false,
          "type": "string",
          "description": "EDItX plugin static asset cache-busting version"
        }
      ],
      "responses": {
        "200": {
          "description": "File found",
          "schema": {
            "type": "file"
          }
        },
        "400": {
          "description": "Bad request",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "description": "An explanation for the error",
                "type": "string"
              }
            }
          }
        },
        "404": {
          "description": "File not found",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "description": "An explanation for the error",
                "type": "string"
              }
            }
          }
        },
        "500": {
          "description": "Internal server error",
          "schema": {
            "type": "object",
            "properties": {
              "error": {
                "description": "An explanation for the error",
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
